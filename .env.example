# Supabase (same project as gilvero-admin) — read-only public key, protected by RLS
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Shared with the admin (WEBSITE_REVALIDATE_SECRET) — lets it refresh pages after a save
REVALIDATE_SECRET=

# Optional: email the studio about each new enquiry (https://resend.com)
RESEND_API_KEY=
# Recipient (defaults to the studio email in admin Settings)
NOTIFY_EMAIL=
# Sender on a domain verified in Resend, e.g. "Gilvero Website <hello@gilvero.com>"
NOTIFY_FROM=
